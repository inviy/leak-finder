# 고지서 자동 읽기 (claude-haiku-5-5). 아래 둘 다 비워 두면 자동 읽기 없이 직접 입력만 동작
# 이 파일에는 실제 값을 쓰지 말 것. 로컬은 .env.local, 배포는 Vercel 프로젝트 환경 변수에 넣기

# 운영(Vercel): ID 페더레이션. 정적 키 없이 Vercel OIDC 토큰을 교환
# ID 들은 비밀값이 아님. 단, 운영에 ANTHROPIC_API_KEY 를 같이 넣으면 키가 먼저 쓰여 페더레이션이 무시됨
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=

# 로컬 개발: API 키 (운영에는 넣지 않기)
ANTHROPIC_API_KEY=
